<div id="groups_and_headings" class="sets-groups-and-headings">
  <p class="budget-sets-intro"><%= t("budgets.sets.intro") %></p>

  <ul class="budget-sets-list">
    <% panels.each do |set, name, groups| %>
      <li>
        <button type="button" id="<%= button_id(set) %>" class="budget-set-button"
                aria-expanded="false" aria-controls="<%= panel_id(set) %>">
          <strong><%= name %></strong>
          <span><%= summary(groups) %></span>
        </button>
      </li>
    <% end %>
  </ul>

  <% panels.each do |set, name, groups| %>
    <section id="<%= panel_id(set) %>" class="groups-and-headings budget-set-panel"
             aria-labelledby="<%= button_id(set) %>" hidden>
      <h2><%= name %></h2>

      <% groups.each do |group| %>
        <h3 id="<%= group.name.parameterize %>"><%= group.name %></h3>
        <% if group.multiple_headings? && !links_disabled? %>
          <p class="group-investments-link">
            <%= link_to t("budgets.groups.investments_link", group: group.name),
                        budget_investments_path(budget.id, group_id: group.id) %>
          </p>
        <% end %>
        <ul class="headings-list">
          <% group.headings.sort_by(&:name).each do |heading| %>
            <li class="heading">
              <%= link_to_unless(
                links_disabled?,
                heading.name,
                budget_investments_path(budget.id, heading_id: heading.id)
              ) %>

              <%= price(heading) %>
            </li>
          <% end %>
        </ul>
      <% end %>
    </section>
  <% end %>
</div>
