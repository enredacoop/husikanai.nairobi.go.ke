<%= back_link_to edit_admin_budgets_wizard_budget_path(budget), t("admin.budgets_wizard.groups.back") %>

<%= header %>

<% if single_heading? %>
  <%= render Admin::Budgets::HelpComponent.new("groups") %>
  <%= render Admin::BudgetsWizard::CreationTimelineComponent.new("groups") %>
  <%= render Admin::BudgetsWizard::Groups::CreationStepComponent.new(new_group, groups.first) %>
<% else %>
  <p class="help-text"><%= t("admin.budgets_wizard.zones.help") %></p>
  <%= render Admin::BudgetsWizard::CreationTimelineComponent.new("zones") %>

  <%= render Admin::BudgetsWizard::Groups::ImportComponent.new(budget, importer) %>

  <section class="groups-and-headings wizard-zones" aria-labelledby="wizard_zones_header">
    <h3 id="wizard_zones_header"><%= t("admin.budgets.show.groups_and_headings") %></h3>
    <% unless budget.groups.exists? || budget.sets.exists? %>
      <div class="callout primary"><%= t("admin.budget_groups.no_groups") %></div>
    <% end %>
    <%= render Admin::Budgets::GroupsAndHeadingsComponent.new(budget, wizard: true) %>
  </section>

  <div class="budget-creation-step">
    <% if budget.headings.exists? %>
      <%= link_to t("admin.budgets_wizard.zones.continue"),
                  admin_budgets_wizard_budget_budget_phases_path(budget),
                  class: "next-step" %>
    <% else %>
      <p class="next-step"><%= t("admin.budgets_wizard.zones.continue") %></p>
    <% end %>
  </div>
<% end %>
